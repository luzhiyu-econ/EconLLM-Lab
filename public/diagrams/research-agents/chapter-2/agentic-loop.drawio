<mxfile host="app.diagrams.net">
  <diagram id="agentic-loop" name="模型与工具的执行循环">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="960" pageHeight="760" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="heading" value="模型判断与框架执行如何接续" style="rounded=0;fillColor=#d9d9d9;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=28;fontStyle=1;html=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="840" height="48" as="geometry"/></mxCell>
        <mxCell id="framework-group" value="" style="rounded=0;fillColor=none;strokeColor=#555555;strokeWidth=1;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="120" y="100" width="320" height="600" as="geometry"/></mxCell>
        <mxCell id="model-group" value="" style="rounded=0;fillColor=none;strokeColor=#555555;strokeWidth=1;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="550" y="100" width="320" height="600" as="geometry"/></mxCell>
        <mxCell id="framework-heading" value="执行框架" style="rounded=0;fillColor=#d9d9d9;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=26;fontStyle=1;html=0;" vertex="1" parent="1"><mxGeometry x="140" y="120" width="280" height="42" as="geometry"/></mxCell>
        <mxCell id="model-heading" value="模型服务" style="rounded=0;fillColor=#d9d9d9;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=26;fontStyle=1;html=0;" vertex="1" parent="1"><mxGeometry x="570" y="120" width="280" height="42" as="geometry"/></mxCell>
        <mxCell id="context" value="组织本轮上下文&#xa;任务、历史与工具结果" style="rounded=0;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=23;html=0;" vertex="1" parent="1"><mxGeometry x="150" y="210" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="model" value="依据上下文判断&#xa;选择操作或结束任务" style="rounded=0;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=24;html=0;" vertex="1" parent="1"><mxGeometry x="580" y="210" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="call" value="工具调用请求&#xa;工具名称与参数" style="rounded=0;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=24;html=0;" vertex="1" parent="1"><mxGeometry x="580" y="390" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="execute" value="调用本地工具&#xa;修改文件、运行编译" style="rounded=0;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=23;html=0;" vertex="1" parent="1"><mxGeometry x="150" y="380" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="results" value="收集工具结果&#xa;编译日志、生成文件" style="rounded=0;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=23;html=0;" vertex="1" parent="1"><mxGeometry x="150" y="550" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="reply" value="生成最终答复&#xa;说明结果与交付位置" style="rounded=0;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=24;html=0;" vertex="1" parent="1"><mxGeometry x="580" y="570" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="request" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="context" target="model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="decide-call" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="model" target="call"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="return-call" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.3;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="call" target="execute"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="collect" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="execute" target="results"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="feedback" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.3;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="results" target="context"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="70" y="600"/><mxPoint x="70" y="260"/></Array></mxGeometry></mxCell>
        <mxCell id="final-reply" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.3;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="model" target="reply"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="260"/><mxPoint x="890" y="610"/></Array></mxGeometry></mxCell>
        <mxCell id="request-label" value="发送请求" style="rounded=0;fillColor=#ffffff;strokeColor=none;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=22;html=0;" vertex="1" parent="1"><mxGeometry x="435" y="224" width="120" height="30" as="geometry"/></mxCell>
        <mxCell id="call-label" value="需要继续操作" style="rounded=0;fillColor=#ffffff;strokeColor=none;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=22;html=0;" vertex="1" parent="1"><mxGeometry x="625" y="337" width="170" height="30" as="geometry"/></mxCell>
        <mxCell id="return-label" value="返回调用" style="rounded=0;fillColor=#ffffff;strokeColor=none;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=22;html=0;" vertex="1" parent="1"><mxGeometry x="435" y="394" width="120" height="30" as="geometry"/></mxCell>
        <mxCell id="collect-label" value="执行并收集" style="rounded=0;fillColor=#ffffff;strokeColor=none;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=22;html=0;" vertex="1" parent="1"><mxGeometry x="210" y="499" width="140" height="30" as="geometry"/></mxCell>
        <mxCell id="feedback-label" value="下一轮" style="rounded=0;fillColor=#ffffff;strokeColor=none;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=22;html=0;" vertex="1" parent="1"><mxGeometry x="25" y="430" width="90" height="34" as="geometry"/></mxCell>
        <mxCell id="final-label" value="满足要求" style="rounded=0;fillColor=#ffffff;strokeColor=none;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=22;html=0;" vertex="1" parent="1"><mxGeometry x="835" y="500" width="110" height="36" as="geometry"/></mxCell>
        <mxCell id="note" value="继续或结束，取决于任务要求和已经取得的结果" style="rounded=0;fillColor=none;strokeColor=none;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=23;html=0;" vertex="1" parent="1"><mxGeometry x="120" y="716" width="750" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
