<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="agentic-loop" name="模型与工具的执行循环">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="960" pageHeight="640" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="framework-group" value="" style="rounded=0;fillColor=none;strokeColor=#555555;strokeWidth=1;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="115.0" y="20.0" width="320" height="600" as="geometry" /></mxCell>
        <mxCell id="model-group" value="" style="rounded=0;fillColor=none;strokeColor=#555555;strokeWidth=1;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="545.0" y="20.0" width="320" height="600" as="geometry" /></mxCell>
        <mxCell id="framework-heading" value="执行框架" style="rounded=0;fillColor=#d9d9d9;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=26;fontStyle=1;html=0;" vertex="1" parent="1"><mxGeometry x="135.0" y="40.0" width="280" height="42" as="geometry" /></mxCell>
        <mxCell id="model-heading" value="模型服务" style="rounded=0;fillColor=#d9d9d9;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=26;fontStyle=1;html=0;" vertex="1" parent="1"><mxGeometry x="565.0" y="40.0" width="280" height="42" as="geometry" /></mxCell>
        <mxCell id="context" value="组织本轮上下文&#10;任务、历史与工具结果" style="rounded=0;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=23;html=0;" vertex="1" parent="1"><mxGeometry x="145.0" y="130.0" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="model" value="依据上下文判断&#10;选择操作或结束任务" style="rounded=0;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=24;html=0;" vertex="1" parent="1"><mxGeometry x="575.0" y="130.0" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="call" value="工具调用请求&#10;工具名称与参数" style="rounded=0;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=24;html=0;" vertex="1" parent="1"><mxGeometry x="575.0" y="310.0" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="execute" value="调用本地工具&#10;修改文件、运行编译" style="rounded=0;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=23;html=0;" vertex="1" parent="1"><mxGeometry x="145.0" y="300.0" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="results" value="收集工具结果&#10;编译日志、生成文件" style="rounded=0;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=23;html=0;" vertex="1" parent="1"><mxGeometry x="145.0" y="470.0" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="reply" value="生成最终答复&#10;说明结果与交付位置" style="rounded=0;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=24;html=0;" vertex="1" parent="1"><mxGeometry x="575.0" y="490.0" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="request" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="context" target="model"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="decide-call" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="model" target="call"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="return-call" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.3;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="call" target="execute"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="collect" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="execute" target="results"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="feedback" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.3;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="results" target="context"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="65.0" y="520.0" /><mxPoint x="65.0" y="180.0" /></Array></mxGeometry></mxCell>
        <mxCell id="final-reply" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.3;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="model" target="reply"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="885.0" y="180.0" /><mxPoint x="885.0" y="530.0" /></Array></mxGeometry></mxCell>
        <mxCell id="request-label" value="发送请求" style="rounded=0;fillColor=#ffffff;strokeColor=none;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=22;html=0;" vertex="1" parent="1"><mxGeometry x="430.0" y="144.0" width="120" height="30" as="geometry" /></mxCell>
        <mxCell id="call-label" value="需要继续操作" style="rounded=0;fillColor=#ffffff;strokeColor=none;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=22;html=0;" vertex="1" parent="1"><mxGeometry x="620.0" y="257.0" width="170" height="30" as="geometry" /></mxCell>
        <mxCell id="return-label" value="返回调用" style="rounded=0;fillColor=#ffffff;strokeColor=none;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=22;html=0;" vertex="1" parent="1"><mxGeometry x="430.0" y="314.0" width="120" height="30" as="geometry" /></mxCell>
        <mxCell id="collect-label" value="执行并收集" style="rounded=0;fillColor=#ffffff;strokeColor=none;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=22;html=0;" vertex="1" parent="1"><mxGeometry x="205.0" y="419.0" width="140" height="30" as="geometry" /></mxCell>
        <mxCell id="feedback-label" value="下一轮" style="rounded=0;fillColor=#ffffff;strokeColor=none;fontColor=#000000;fontFamily=Noto Serif CJK SC;fontSize=22;html=0;" vertex="1" parent="1"><mxGeometry x="20.0" y="350.0" width="90" height="34" as="geometry" /></mxCell>
